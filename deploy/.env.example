# Copy to deploy/.env on the server and fill in. Never commit the real file.
#   cp deploy/.env.example deploy/.env

# --- identity ---------------------------------------------------------------
# Passkeys are cryptographically bound to YAYO_RP_ID. Changing it invalidates
# every registered passkey, so get it right the first time.
YAYO_SITE_ORIGIN=https://travel.foryayo.com
YAYO_RP_ID=travel.foryayo.com
YAYO_RP_NAME=Yayo travel

# --- Gmail ingest (stage 8) -------------------------------------------------
# App Password from https://myaccount.google.com/apppasswords (needs 2FA on).
# It is a 16-character string; paste it without spaces.
YAYO_EMAIL_INGEST_ENABLED=false
YAYO_IMAP_HOST=imap.gmail.com
YAYO_IMAP_PORT=993
YAYO_IMAP_USER=
YAYO_IMAP_APP_PASSWORD=

# --- extraction (stage 8) ---------------------------------------------------
# Use a dedicated key you can rotate without affecting anything else.
YAYO_ANTHROPIC_API_KEY=

# --- behaviour --------------------------------------------------------------
YAYO_SESSION_DAYS=90
YAYO_BACKUP_KEEP_DAYS=30
YAYO_LOG_LEVEL=INFO
