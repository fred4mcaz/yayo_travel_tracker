  "_confirmation_comment": [
    "Checked against subject and body. An allowed sender still has to look",
    "like a booking -- their marketing mail should stay on the box too."
  ],
  "confirmation_keywords": [
    "confirmation",
    "confirmed",
    "your booking",
    "booking reference",
    "booking number",
    "reservation",
    "itinerary",
    "e-ticket",
    "eticket",
    "ticket",
    "boarding pass",
    "check-in",
    "your stay",
    "your trip",
    "your flight",
    "your reservation",
    "record locator",
    "pnr"
  ],

  "_deny_comment": [
    "Subject only. Real confirmations carry an unsubscribe footer in the body,",
    "so matching denials against the body would veto the mail we want."
  ],
  "subject_deny_keywords": [
    "newsletter",
    "deals",
    "deal alert",
    "price alert",
    "sale",
    "% off",
    "promo",
    "promotion",
    "survey",
    "rate your",
    "review your",
    "how was your",
    "inspiration",
    "recommended for you",
    "earn points",
    "last chance"
  ]
